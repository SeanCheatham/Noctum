# Dependencies (will be installed during build)
node_modules/

# Build outputs (will be generated during build)
packages/*/dist/

# Development files
.git/
.github/
*.log
*.md
.claude/

# IDE
.vscode/
.idea/

# Test files
**/__tests__/
**/*.test.ts
**/*.spec.ts

# Docker files (prevent recursive copy)
noctum/
