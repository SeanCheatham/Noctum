{
  "name": "@noctum/shared",
  "version": "0.1.0",
  "description": "Shared types for Noctum packages",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "license": "MIT OR Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.54.0"
  }
}
