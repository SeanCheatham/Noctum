{
  "name": "@noctum/cli",
  "version": "0.1.0",
  "description": "AI-powered sandboxed simulation testing CLI",
  "type": "module",
  "bin": {
    "noctum": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "testing",
    "simulation",
    "sandbox",
    "ai",
    "llm"
  ],
  "license": "MIT OR Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "commander": "^14.0.0"
  }
}
