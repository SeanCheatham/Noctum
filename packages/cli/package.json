{
  "name": "@noctum/cli",
  "version": "0.1.0",
  "description": "AI-powered sandboxed simulation testing CLI",
  "type": "module",
  "bin": {
    "noctum": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts serve",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "testing",
    "simulation",
    "sandbox",
    "ai",
    "llm"
  ],
  "license": "MIT OR Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.29",
    "@noctum/web": "*",
    "commander": "^14.0.0"
  }
}
